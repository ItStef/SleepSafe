generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  LOGIN
  RECOVERY
  RECOVERY_RESET
}

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  email           String    @unique
  emailVerifiedAt DateTime?

  authHash        String
  kdfSalt         String
  kdfMemoryKiB    Int
  kdfIterations   Int
  kdfParallelism  Int
  wrappedVaultKey Json
  vaultRevision   Int    @default(0)

  // Parametri za izvodjenje kljuceva iz kodova za oporavak (svih 20 koristi isti skup).
  recoverySalt           String?
  recoveryKdfMemoryKiB   Int?
  recoveryKdfIterations  Int?
  recoveryKdfParallelism Int?


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions      Session[]
  otpChallenges OtpChallenge[]
  vaultItems    VaultItem[]
  recoveryCodes RecoveryCode[]

  @@map("users")
}

model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique
  previousRefreshTokenHash String?
  deviceName       String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([previousRefreshTokenHash])
  @@map("sessions")
}

model OtpChallenge {
  id         String     @id @default(uuid(7)) @db.Uuid
  userId     String     @db.Uuid
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("otp_challenges")
}

model VaultItem {
  id        String    @db.Uuid
  userId    String    @db.Uuid
  envelope  Json?
  revision  Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, id])
  @@unique([userId, revision])
  @@map("vault_items")
}


// Jedan kod za oporavak: server cuva samo HMAC dokaza posedovanja i Vault Key umotan kljucem
// izvedenim iz koda. Sam kod nikad ne dolazi do servera.
model RecoveryCode {
  id              String    @id @default(uuid(7)) @db.Uuid
  userId          String    @db.Uuid
  codeHash        String
  wrappedVaultKey Json
  usedAt          DateTime?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([userId])
  @@map("recovery_codes")
}
