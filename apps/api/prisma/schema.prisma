generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  LOGIN
}

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  email           String    @unique
  emailVerifiedAt DateTime?

  authHash        String
  kdfSalt         String
  kdfMemoryKiB    Int
  kdfIterations   Int
  kdfParallelism  Int
  wrappedVaultKey Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions      Session[]
  otpChallenges OtpChallenge[]
  vaultItems    VaultItem[]

  @@map("users")
}

model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique
  previousRefreshTokenHash String?
  deviceName       String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([previousRefreshTokenHash])
  @@map("sessions")
}

model OtpChallenge {
  id         String     @id @default(uuid(7)) @db.Uuid
  userId     String     @db.Uuid
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("otp_challenges")
}

model VaultItem {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  envelope  Json
  version   Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("vault_items")
}
