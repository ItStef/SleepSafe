generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  LOGIN
}

enum AuditEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  PASSWORD_CHANGED
  ACCOUNT_DELETED
  SESSION_REVOKED
}

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  email           String    @unique
  emailVerifiedAt DateTime?

  authHash        String
  kdfSalt         String
  kdfMemoryKiB    Int
  kdfIterations   Int
  kdfParallelism  Int
  wrappedVaultKey Json
  vaultRevision   Int    @default(0)


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions      Session[]
  otpChallenges OtpChallenge[]
  vaultItems    VaultItem[]
  auditEvents AuditEvent[]

  @@map("users")
}

model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique
  previousRefreshTokenHash String?
  deviceName       String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([previousRefreshTokenHash])
  @@map("sessions")
}

model OtpChallenge {
  id         String     @id @default(uuid(7)) @db.Uuid
  userId     String     @db.Uuid
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("otp_challenges")
}

model VaultItem {
  id        String    @db.Uuid
  userId    String    @db.Uuid
  envelope  Json?
  revision  Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, id])
  @@unique([userId, revision])
  @@map("vault_items")
}

model AuditEvent {
  id        String         @id @default(uuid(7)) @db.Uuid
  userId    String?        @db.Uuid
  email     String?
  type      AuditEventType
  ip        String?
  userAgent String?
  createdAt DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("audit_events")
}
