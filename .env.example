# Kopiraj u .env i promeni lozinku. Fajl .env se NIKAD ne commit-uje.

# --- PostgreSQL (koristi ga docker-compose) ---
POSTGRES_USER=sleepsafe
POSTGRES_PASSWORD=promeni-me
POSTGRES_DB=sleepsafe
POSTGRES_PORT=5432
JWT_SECRET=promeni-me
SERVER_PEPPER=promeni-me

# --- Aplikacija ---
DATABASE_URL=postgresql://sleepsafe:promeni-me@localhost:5432/sleepsafe

# --- Mailpit (lazni email server, samo za razvoj) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
