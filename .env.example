# Kopiraj u .env i promeni vrednosti. Fajl .env se NIKAD ne commit-uje.
# Provera podesavanja i okruzenja (Windows, macOS, Linux): pnpm check:env

# --- PostgreSQL ---
POSTGRES_USER=sleepsafe
POSTGRES_PASSWORD=promeni-me
POSTGRES_DB=sleepsafe
POSTGRES_PORT=5432

# --- Tajne servera: najmanje 32 znaka, medjusobno razlicite ---
# Generisanje: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=promeni-me-promeni-me-promeni-me-1234
SERVER_PEPPER=promeni-me-promeni-me-promeni-me-5678

# --- Razvoj na racunaru (pnpm db:up, pnpm dev:api, pnpm dev:web) ---
DATABASE_URL=postgresql://sleepsafe:promeni-me@localhost:5432/sleepsafe
# Adresa na kojoj otvarate veb klijent. Mora se poklapati sa adresom u pregledacu (koristite
# localhost, ne 127.0.0.1). U razvoju je to Vite: http://localhost:5173
APP_URL=http://localhost:5173

# Mailpit: lazni email server za razvoj, kodove citate na http://localhost:8025
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Ceo sistem u kontejnerima (pnpm stack:up ili pnpm stack:demo) ---
# Adresa pod kojom se otvara aplikacija. localhost radi odmah na ovom racunaru; za pristup sa
# drugih uredjaja upisite adresu ovog racunara (na primer 192.168.1.20).
# SITE_ADDRESS=localhost
# Ako HTTPS_PORT nije 443, upisite i punu adresu, na primer STACK_APP_URL=https://localhost:8443
# CADDY_TLS=internal
# HTTP_PORT=80
# HTTPS_PORT=443
#
# pnpm stack:demo: probni rezim, kodovi stizu u Mailpit, nije za pravo koriscenje.
# pnpm stack:up: pravo koriscenje (NODE_ENV=production), traži pravi SMTP ispod.

# --- Email server (SMTP) za pravo koriscenje ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_TLS=starttls
# SMTP_USER=korisnik
# SMTP_PASS=lozinka
# SMTP_FROM=SleepSafe <no-reply@example.com>
