{
  "name": "sleepsafe",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d",
    "db:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "db:generate": "pnpm --filter @sleepsafe/api db:generate",
    "db:migrate": "pnpm --filter @sleepsafe/api db:migrate",
    "dev:api": "pnpm --filter @sleepsafe/api dev",
    "dev:web": "pnpm --filter @sleepsafe/web dev",
    "stack:up": "docker compose --env-file .env -f infra/docker-compose.yml --profile app up -d --build",
    "stack:demo": "docker compose --env-file .env -f infra/docker-compose.yml -f infra/docker-compose.demo.yml --profile app up -d --build",
    "stack:down": "docker compose --env-file .env -f infra/docker-compose.yml --profile app down",
    "stack:logs": "docker compose --env-file .env -f infra/docker-compose.yml --profile app logs -f --tail=100",
    "check:env": "node scripts/check-env.mjs"
  },
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.5.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.5.1",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
